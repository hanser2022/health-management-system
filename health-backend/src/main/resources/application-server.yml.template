# ============================================
# 服务器环境配置模板
# 复制此文件为 application-server.yml 并填入真实值
# cp application-server.yml.template application-server.yml
# ============================================
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/health?useUnicode=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: YOUR_SERVER_DB_PASSWORD

  data:
    redis:
      host: 127.0.0.1
      port: 6379

  ai:
    openai:
      api-key: ${AI_API_KEY:YOUR_AI_API_KEY}

logging:
  level:
    com.shanzhu: info
